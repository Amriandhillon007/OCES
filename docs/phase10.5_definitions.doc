# Definition 1: State Space
# M = { Φ ∈ R^d : ||Φ|| ≤ R }
# where R = manifold_radius (empirically, R ≈ 1.0 from state normalization)

# Definition 2: Metric
# d_g(x, y) = ||x - y||_2  (Euclidean, operational)

# Definition 3: Archive
# A_t = {a_1, a_2, ..., a_n} ⊂ M
# |A_t| ≤ archive_limit (default: 500)

# Definition 4: Novelty Functional
# N_t(x) = min_{a ∈ A_t} d_g(x, a)

# Definition 5: Coverage
# Cov_t = Vol(∪ B_r(a)) / Vol(M)
# where B_r(a) = { x ∈ M : d_g(x, a) < r }

# Definition 6: Bounded Exploration
# d(T(x), T(y)) ≤ L · d(x, y)
# where L < ∞ is Lipschitz constant

