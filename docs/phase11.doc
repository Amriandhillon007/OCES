11. COMPLETE CODE REFERENCE
11.1 Final Validated Configuration
python
@dataclass
class Phase11Config:
    # Mode
    mode: str = "longhorizon"
    
    # System dimensions
    ontology_dim: int = 16
    num_ontologies: int = 2
    
    # ES parameters (OPTIMAL)
    es_samples: int = 5
    es_sigma: float = 0.08
    es_alpha: float = 0.03
    
    # Network
    law_hidden_size: int = 6
    
    # Dynamics
    dt: float = 0.01
    noise_scale: float = 0.008
    
    # Residual mixing (CRITICAL)
    residual_mix_base: float = 0.2
    residual_mix_range: float = 0.3
    
    # Novelty archive
    behavioral_archive_size: int = 500
    
    # Task environment
    task_switch_interval: int = 1000
    task_difficulty: float = 0.5
    environmental_drift: float = 0.01
    
    # Fitness weights (VALIDATED)
    w_divergence: float = 0.25
    w_sensitivity: float = 0.20
    w_entropy: float = 0.15
    w_utility: float = 0.20
    w_stability: float = 0.20
